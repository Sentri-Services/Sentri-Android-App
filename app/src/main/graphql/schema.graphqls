  title: String!
}

input BiosafetyAddVaccineBrandInput {
  brand_name_cn: String!
  brand_name_en: String!
  dosage_form: BiosafetyVaccineDosageForm!
  immunization_interval_days: Int = null
  routes: [BiosafetyVaccinationRoute!]! = []
  single_dose_text: String = null
  vaccine_id: String!
  vaccine_type: BiosafetyVaccineType = null
  validity_period_text: String = null
  withdrawal_period_days: Int = null
}

input BiosafetyAddVaccineInput {
  name_cn: String!
  name_en: String!
  target_antibody_project: BiosafetySampleTestProject!
}

