schema {
  query: query_root
  mutation: mutation_root
  subscription: subscription_root
}

"""whether this query should be cached (Hasura Cloud only)"""
directive @cached(
  """refresh the cache entry"""
  refresh: Boolean! = false

  """measured in seconds"""
  ttl: Int! = 60
) on QUERY

type BiosafetyAccessRoleInfoStrawberryType {
  access_role_id: String!
  is_default: Boolean!
  members: [String!]!
  need_credential: Boolean!
  resources: [String!]!
}

type BiosafetyAccessRoleMutationResponse {
  errors: [ProductionError!]!
  record: BiosafetyAccessRoleInfoStrawberryType
  recordId: String!
  status: BiosafetyResponseStatus!
}

input BiosafetyAddAccessRoleInput {
  access_role_id: String = null
  is_default: Boolean!
  is_on_farm: Boolean!
  is_temporary: Boolean!
  name: String!
  need_credential: Boolean!
  resources: [String!]! = []
}

input BiosafetyAddCredentialIdInput {
  base64_text: String!
  content_type: String! = "application/pdf"
  credential_name: String! = ""
}

input BiosafetyAddCustomerEventLogCommandStrawberryInput {
  data: BiosafetyJSON!
  module: String! = "biosafety"
}

input BiosafetyAddFaceIdInput {
  base64_text: String!
  user_id: BiosafetyUserId!
}

input BiosafetyAddFarmCameraInput {
  code: String!
  display_name: String = null
}

input BiosafetyAddFarmPenGroupInput {
  end_number: Int!
  from_number: Int!
  pen_type_name: String!
  row_code: String!
}

input BiosafetyAddFarmPenTypeInput {
  capacity: Int!
  feed_stations: Int!
  is_default: Boolean!
  is_farrowing: Boolean!
  name: String!
  water_stations: Int!
}

input BiosafetyAddFarmSectionInput {
  camera_code: BiosafetyFarmCameraCode!
  name_cn: String!
  name_en: String!
  zone_code: String!
}

input BiosafetyAddFarmUnitInput {
  area_type: BiosafetyFarmAreaType!
  camera_code: String!
  name_cn: String!
  name_en: String!
  section_code: String!
}

input BiosafetyAddFarmUnitRowInput {
  row_number: String!
  unit_code: String!
}

input BiosafetyAddFarmZoneInput {
  code: String!
  name_cn: String!
  name_en: String!
}

input BiosafetyAddGuestFaceIdInput {
  base64_text: String!
  face_id: String = null
  invite_id: String!
  phone_number: String!
}

input BiosafetyAddMedicationCatalogInput {
  form_cn: String!
  form_en: String!
  medication_id: String!
  name_cn: String!
  name_en: String!
}

input BiosafetyAddMedicationInput {
  name_cn: String!
  name_en: String!
}

input BiosafetyAddPigDiseaseInput {
  disease_ids: [String!]! = []
  ear_tag: String = null
  image_urls: [String!]! = []
  pen_location: String = null
  pig_id: BiosafetyPigId!
  reason: String = null
  triage_level: BiosafetyPigTriageLevel = null
}

input BiosafetyAddPigSymptomInput {
  ear_tag: String = null
  image_urls: [String!]! = []
  pen_location: String = null
  pig_id: BiosafetyPigId!
  reason: String = null
  symptom_ids: [String!]! = []
  triage_level: BiosafetyPigTriageLevel = null
}

input BiosafetyAddPrescriptionTargetInput {
  prescription_id: BiosafetyPrescriptionId!
  reason: String = null
  targets: [BiosafetyPrescriptionTargetParamInput!]! = []
}

input BiosafetyAddSamplingReportInput {
  base64_data: String!
  content_type: String!
  report_id: String = null
  report_name: String!
}

input BiosafetyAddSamplingTestInput {
  auto_sampling: Boolean! = false
  container: BiosafetySampleContainer!
  projects: [BiosafetySampleTestProject!]! = []
  sampling_at: BiosafetyDatetime = null
  sampling_by: BiosafetyUserId = null
  sampling_id: String!
  targets: [BiosafetySamplingTestTargetInput!]! = []
  test_id: String = null
}

input BiosafetyAddUserInput {
  email: String = null
  first_name: String!
  last_name: String!
  oauth_id: String! = ""
  owner: String!
  password: String = null
  phone_number: String = null
