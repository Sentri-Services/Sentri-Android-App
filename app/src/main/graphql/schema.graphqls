"""PigId scalar type"""
scalar BiosafetyPigId

enum BiosafetyPigTargetFilterCombinator {
  AND
  OR
}

enum BiosafetyPigTargetFilterField {
  AGE_DAYS
  BREED
  ORIGIN
  PARITY
  WEIGHT_KG
}

input BiosafetyPigTargetFilterInput {
  field: BiosafetyPigTargetFilterField!
  numeric_values: [Float!]! = []
  operator: BiosafetyPigTargetFilterOperator!
  value: Float = null
  values: [String!]! = []
}

enum BiosafetyPigTargetFilterOperator {
  BETWEEN
  GT
  GTE
  IN
  LT
  LTE
  NOT_IN
}

enum BiosafetyPigTargetGroup {
  BREEDING_BOAR
  BREEDING_SOW
  COMMERCIAL_PIG
  PRODUCTION_BOAR
  PRODUCTION_SOW
}

type BiosafetyPigTargetSelectionPreview {
  count: Int!
}

type BiosafetyPigTargetSelectionPreviewResponse {
  errors: [ProductionError!]!
  preview: BiosafetyPigTargetSelectionPreview
  status: BiosafetyResponseStatus!
}

input BiosafetyPigTargetSelectionSpecInput {
  combinator: BiosafetyPigTargetFilterCombinator! = AND
  filters: [BiosafetyPigTargetFilterInput!]! = []
  target_group: BiosafetyPigTargetGroup!
}

enum BiosafetyPigTriageLevel {
  Emergency
  Healthy
  Normal
  Priority
}

"""PrescriptionId scalar type"""
scalar BiosafetyPrescriptionId

type BiosafetyPrescriptionInfoStrawberryType {
  prescription_id: String!
  status: String!
