  unit: String!
}

input BiosafetyPreviewPigTargetSelectionInput {
  as_of: BiosafetyDatetime = null
  target_selection_spec: BiosafetyPigTargetSelectionSpecInput!
}

enum BiosafetyProductionScheduleTriggerType {
  AFTER_PRODUCTION_TASK_END
  BEFORE_PRODUCTION_TASK_START
  PRODUCTION_STATUS
}

enum BiosafetyProductionStatus {
  FATTENING
  IN_ESTRUS
  LACTATING
  MATED
  NOT_IN_ESTRUS
  OBSOLETED
  PREGNANT
}

input BiosafetyProductionTaskScheduleRuleInput {
  offset_days: Int! = 0
  production_status: BiosafetyProductionStatus = null
  production_task_type: BiosafetyBatchTaskType = null
  trigger_type: BiosafetyProductionScheduleTriggerType!
}

