  archiveMaterial(materialId: String!): InventoryInventoryMutationResult!
  archiveMaterialType(input: InventoryMaterialTypeInput!, materialTypeId: String!, version: Int!): InventoryInventoryMutationResult!
  bootstrapInventoryMaterialTypes: InventoryInventoryMutationResult!
  cancelInventoryPlan(effectiveAt: InventoryDateTime!, inventoryId: String!, lines: [InventoryCancelPlanLineInput!]!, planId: String!): InventoryInventoryMutationResult!
  createInventoryPlan(inventoryId: String!, lines: [InventoryPlanLineInput!]!): InventoryCreateInventoryPlanResult!
  createMaterial(input: InventoryMaterialInput!): InventoryInventoryMutationResult!
  createMaterialType(input: InventoryMaterialTypeInput!): InventoryInventoryMutationResult!
  executeInventoryOutbound(effectiveAt: InventoryDateTime!, inventoryId: String!, lines: [InventoryExecuteOutboundLineInput!]!): InventoryExecuteInventoryOutboundResult!
  finalizeInventoryOutbound(effectiveAt: InventoryDateTime!, inventoryId: String!, lines: [InventoryFinalizeOutboundLineInput!]!, outboundBatchId: String!): InventoryFinalizeInventoryOutboundResult!
  receiveInventory(effectiveAt: InventoryDateTime!, inventoryId: String!, lines: [InventoryReceiveLineInput!]!, receiptNo: String = null, receiptType: String = null, receiptTypeLabel: String = null, remark: String = null): InventoryReceiveInventoryResult!
  releaseInventoryReservation(effectiveAt: InventoryDateTime!, inventoryId: String!, lines: [InventoryReleaseReservationLineInput!]!): InventoryInventoryMutationResult!
  removeMaterialUnitConversion(materialId: String!, unit: String!): InventoryInventoryMutationResult!
  reserveInventory(effectiveAt: InventoryDateTime!, inventoryId: String!, lines: [InventoryReserveLineInput!]!): InventoryReserveInventoryResult!
  updateMaterial(input: InventoryMaterialInput!, materialId: String!): InventoryInventoryMutationResult!
  updateMaterialType(input: InventoryMaterialTypeInput!, materialTypeId: String!, version: Int!): InventoryInventoryMutationResult!
  updateMaterialUnitConversion(input: InventoryMaterialUnitConversionInput!, materialId: String!): InventoryInventoryMutationResult!
}

