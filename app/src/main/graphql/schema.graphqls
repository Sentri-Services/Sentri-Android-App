"""Date (isoformat)"""
scalar DashboardDate

"""Date with time (isoformat)"""
scalar DashboardDateTime

type DashboardDecisionActionErrorType {
  code: String!
  message: String!
  reason_key: String!
  retryable: Boolean!
}

type DashboardDecisionActionResponseType {
  code: String!
  data: DashboardJSON
  errors: [DashboardDecisionActionErrorType!]!
  message: String
  status: DashboardDecisionActionStatus!
}

enum DashboardDecisionActionStatus {
  FAILED
  SUCCEEDED
}

type DashboardDecisionFeedType {
  action_keys: [String!]
  decision_id: String!
  decision_type: String!
  entity_primary_id: String
  entity_primary_type: String
  farm_id: String!
  is_visible: Boolean!
  module: String!
  occurred_at: DashboardDateTime!
  template_vars: DashboardJSON
  updated_at: DashboardDateTime!
}

input DashboardExecuteDecisionActionInput {
  action_key: String!
  actor_id: String = null
  decision_id: String!
  payload: DashboardJSON = null
}

input DashboardExecuteNotificationActionInput {
  actor_id: String = null
  notification_id: String!
}

